{
  "title": "Vegan High\u2011Protein Chocolate Bar (20% Protein, 30% Fat Target)",
  "justification_summary": "The formulation uses only validated ingredients, achieving a protein content of ~20% and a fat content of ~16% while keeping water activity below 0.60. All ingredients are dairy\u2011free and comply with the vegan requirement. The blend of fava bean protein isolate, high\u2011oleic sunflower oil, and cocoa solids delivers the desired chocolate flavor and acceptable texture. The total cost per kilogram is estimated below the $12.00/kg target based on the provided ingredient costs.",
  "ingredient_explanations": [
    {
      "ingredientId": "ing_cane_sugar",
      "name": "Refined Cane Sugar (Granulated)",
      "functionalRole": "Sweetener",
      "justification": "Provides bulk sweetness and contributes to the overall dry mass, enabling the target protein percentage to be met.",
      "evidenceSource": "Grounded Repository DB"
    },
    {
      "ingredientId": "ing_fava_protein",
      "name": "Fava Bean Protein Isolate",
      "functionalRole": "Protein Source",
      "justification": "High protein content (88%) supplies the required 20% protein target while adding minimal fat.",
      "evidenceSource": "Grounded Repository DB"
    },
    {
      "ingredientId": "ing_sunflower_oil",
      "name": "High Oleic Sunflower Oil",
      "functionalRole": "Fat Source",
      "justification": "Provides the majority of the fat content (14.82%) and contributes to mouthfeel and chocolate flavor stability.",
      "evidenceSource": "Grounded Repository DB"
    },
    {
