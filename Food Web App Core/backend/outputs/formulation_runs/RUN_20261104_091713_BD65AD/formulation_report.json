{
  "title": "Vegan High-Protein Chocolate Bar",
  "justification_summary": "The formulation achieves the target protein content (~20%) primarily through soy protein isolate (21.1% of the mix, 90% protein by weight) and cocoa powder (5% of the mix, 20% protein by weight), resulting in ~20% protein overall. Fat content is maintained below the 30% ceiling by using cocoa butter (15% of the mix, 100% fat) and cocoa powder (5% of the mix, 11% fat), giving a total fat of ~16%. All ingredients are plant\u2011derived and comply with the strict vegan requirement. The low moisture matrix (sugar, protein isolate, cocoa solids, and cocoa butter) supports a water activity below 0.60, and the inclusion of ammonium phosphatides and a plant\u2011derived gum provides emulsification and textural stability. The formulation is fully within the cost target (average raw material cost <12\u202fUSD/kg) and is expected to have ambient shelf stability of at least 12\u202fmonths, meeting all hard constraints and soft objectives.",
  "ingredient_explanations": [
    {
      "ingredientId": "ing_cane_sugar",
      "name": "Refined Cane Sugar (Granulated)",
      "functionalRole": "Sweetener",
      "justification": "Provides bulk sweetness and contributes to the overall dry matrix, helping to lower water activity.",
      "evidenceSource": "Codex Alimentarius Standard 212-1999"
    },
    {
      "ingredientId": "ing_soy_protein",
      "name": "Soy Protein Isolate",
      "functionalRole": "Protein Source",
      "justification": "High\u2011purity protein (90% by weight) delivers the majority of the target protein content while keeping fat low.",
      "evidenceSource": "Food Chemistry Vol 312"
    },
    {
      "ingredientId": "ing_cocoa_butter",
      "name": "Prime Press Cocoa Butter",
      "functionalRole": "Fat Source",
      "justification": "Provides the primary fat component (100% fat) necessary for chocolate mouthfeel and texture while staying within the 30% fat limit.",
      "evidenceSource": "Journal of the American Oil Chemists' Society"
    },
    {
      "ingredientId": "ing_cocoa_powder",
      "name": "Dutch Processed Cocoa Powder 10-12%",
      "functionalRole": "Cocoa Solids / Flavor",
      "justification": "Contributes chocolate flavor, protein, and a small amount of fat, enhancing overall sensory profile.",
      "evidenceSource": "USDA FDC"
    },
    {
      "ingredientId": "ing_gum_(plant_derived_substance)",
      "name": "gum (plant derived substance)",
      "functionalRole": "Emulsifier / Texture Stabilizer",
      "justification": "Improves dispersion of cocoa solids and stabilizes the chocolate matrix, aiding in mouthfeel.",
      "evidenceSource": "Grounded Repository DB"
    },
    {
      "ingredientId": "ing_ammonium_phosphatides",
      "name": "Ammonium Phosphatides (INS 442)",
      "functionalRole": "Emulsifier",
      "justification": "Enhances fat dispersion and reduces viscosity, contributing to a smooth texture.",
      "evidenceSource": "EFSA Scientific Opinion on Ammonium Phosphatides (E 442) / Codex Stan 87-1981"
    },
    {
      "ingredientId": "ing_fudge_(vanilla_and_chocolate_marble_top)",
      "name": "fudge (vanilla and chocolate marble top)",
      "functionalRole": "Flavor System",
      "justification": "Adds subtle vanilla notes that complement the chocolate flavor without adding significant moisture.",
      "evidenceSource": "Grounded Repository DB"
    },
    {
      "ingredientId": "ing_sea_salt",
      "name": "Natural Sea Salt",
      "functionalRole": "Flavor Enhancer",
      "justification": "Balances sweetness and enhances chocolate flavor perception.",
      "evidenceSource": "USDA FDC"
    },
    {
      "ingredientId": "ing_potassium_sorbate",
      "name": "Potassium Sorbate (INS 202)",
      "functionalRole": "Preservative",
      "justification": "Prevents microbial growth, supporting the 12\u2011month ambient shelf life.",
      "evidenceSource": "FSSAI Schedule II / Codex GSFA"
    }
  ],
  "process_recommendations": [
    "Phase 1 \u2013 Dry Blending: Combine refined cane sugar, soy protein isolate, cocoa powder, cocoa butter, plant\u2011derived gum, ammonium phosphatides, fudge flavor, sea salt, and potassium sorbate in a high\u2011speed dry mixer for 5\u202fminutes to ensure uniform dispersion.",
    "Phase 2 \u2013 Conching & Tempering: Melt the blend in a conching unit at 45\u201350\u202f\u00b0C for 30\u202fminutes, then temper by cycling between 30\u202f\u00b0C and 27\u202f\u00b0C to develop a smooth, glossy chocolate matrix.",
    "Phase 3 \u2013 Molding & Cooling: Pour the tempered chocolate into pre\u2011cooled molds, allow to set at 18\u201320\u202f\u00b0C for 10\u202fminutes, then cool to room temperature before packaging in moisture\u2011controlled, airtight wrappers."
  ],
